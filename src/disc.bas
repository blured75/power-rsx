10 ' RUN"DISC" - loads the RSX commands and shows the demo menu
20 MEMORY &9FFF:LOAD"RSX.BIN",&A000:CALL &A000
30 MODE 1:INK 0,1:INK 1,24:BORDER 1
40 LOCATE 11,2:PRINT"democpc2 RSX demos"
50 LOCATE 3,5:PRINT"1  ";CHR$(124);"GOTO and ";CHR$(124);"LABEL"
60 LOCATE 3,7:PRINT"2  ";CHR$(124);"GOSUB"
70 LOCATE 3,9:PRINT"3  ";CHR$(124);"IF ";CHR$(124);"ELSE ";CHR$(124);"ENDIF"
80 LOCATE 3,11:PRINT"4  All together: number hunt"
90 LOCATE 3,13:PRINT"5  Vinyl collection manager"
95 LOCATE 3,15:PRINT"6  Self test"
100 LOCATE 3,18:PRINT"Choose 1-6, or Q to quit"
110 |LABEL,"wait"
120 k$=UPPER$(INKEY$)
130 |IF,k$="1":|THEN:RUN"DEMOGOTO":|ENDIF
140 |IF,k$="2":|THEN:RUN"DEMOGOSB":|ENDIF
150 |IF,k$="3":|THEN:RUN"DEMOIF":|ENDIF
160 |IF,k$="4":|THEN:RUN"DEMOALL":|ENDIF
165 |IF,k$="5":|THEN:RUN"VINYL":|ENDIF
170 |IF,k$="6":|THEN:RUN"TEST":|ENDIF
180 |IF,k$="Q":|THEN:MODE 2:END:|ENDIF
190 |GOTO,"wait"
